{
  "manifest_version": 3,
  "name": "GitHub 中文翻译 (GitHub Zh Translator)",
  "version": "1.0.0",
  "description": "在 GitHub 页面上把英文自动翻译成简体中文，只翻译正文，不翻译代码/变量名/URL。支持 Google / DeepSeek / DeepL 引擎。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://*.github.com/*", "https://github.com/*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub 中文翻译"
  }
}
